{
  "name": "taskbar-pos-hero",
  "productName": "POS Hero",
  "version": "1.8.2",
  "description": "Thai POS reconciliation tool, reskinned as a taskbar-docked hero widget (inspired by TBH: Task Bar Hero)",
  "main": "main.js",
  "author": "xziramoon",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/xziramoon/pos-lan.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "release": "electron-builder --publish always",
    "test": "node test/merge.test.js"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.xziramoon.poshero",
    "productName": "POS Hero",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.ico",
      "build/tray.png",
      "build/raw-print.ps1"
    ],
    "asarUnpack": [
      "build/raw-print.ps1"
    ],
    "publish": {
      "provider": "github",
      "owner": "xziramoon",
      "repo": "pos-lan",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
